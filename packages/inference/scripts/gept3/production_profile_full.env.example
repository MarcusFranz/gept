# GePT3 production-grade full-run profile (example)
# Usage:
#   source packages/inference/scripts/gept3/production_profile_full.env.example
#   packages/inference/scripts/gept3/run_gept3_production_pipeline.sh

# Set repo root on the training host.
export ROOT=/path/to/gept

# Required DB env (set real value).
export DB_HOST=localhost
export DB_PORT=5432
export DB_NAME=osrs_data
export DB_USER=osrs_user
export DB_PASS=REPLACE_ME

# Pipeline stage: all | row | hybrid | train
export STAGE=all

# Training device for production server.
export DEVICE=cuda
export PRECISION=fp16

# Preflight guards (tune for server size).
export MIN_FREE_DISK_GB=250
export MIN_RAM_GB=96

# Full-history row dataset intent.
export LOOKBACK_DAYS=365
export ITEM_SOURCE=predictions
export PREDICTIONS_MODEL_ID=
export MAX_ITEMS=0
export SAMPLE_EVERY=1
export MAX_ROWS_PER_ITEM=0

# Paths.
export ROW_DATASET=$ROOT/packages/inference/data/gept3_row_365d_preditems_allmodels_every1_uncapped_multitask_h1-24.npz

# Hybrid dataset sizing.
# IMPORTANT: max_snapshots drives RAM usage during training prep.
# Start with 12k on 128GB RAM, 18k on 256GB RAM, 24k+ on 512GB RAM.
export SEQ_LEN=48
export SNAPSHOT_SIZE=128
export MIN_ITEMS_PER_SNAPSHOT=24
export MAX_SNAPSHOTS=18000
export SELECT_MODE=uniform
export ROW_PICK_MODE=random
export HYBRID_DATASET=$ROOT/packages/inference/data/gept3_hybrid_snap_365d_preditems_allmodels_s128_t48_n18000_min24_multitask_h1-24.npz

# Production model/training config.
export EPOCHS=12
export BATCH_SIZE=2
export EVAL_BATCH_SIZE=2
export EVAL_MAX_BATCHES=250
export LR=2.5e-4
export WEIGHT_DECAY=1e-4
export D_MODEL=384
export N_HEADS=12
export N_LAYERS=6
export TEMPORAL_N_HEADS=6
export TEMPORAL_N_LAYERS=3
export FF_MULT=4.0
export DROPOUT=0.10
export GRAD_ACCUM_STEPS=4
export CHECKPOINT_EVERY_EPOCHS=1
export AUTO_RESUME=1

# Keep run name stable for resume continuity.
export RUN_NAME=gept3_hybrid_prod_s128_t48_n18000_d384_l6_tl3_e12_b2_ga4
